{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "account_summary": {"type": "string", "minLength": 1, "maxLength": 1600},
    "target_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_key": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1200},
          "kind": {"type": "string", "enum": ["attribute", "relation", "internal_consistency", "text_claim"]},
          "predicate": {"type": "string", "minLength": 1, "maxLength": 100},
          "anchor_fact_ids": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string"}},
          "salience": {"type": "string", "enum": ["high", "medium"]}
        },
        "required": ["claim_key", "statement", "kind", "predicate", "anchor_fact_ids", "salience"]
      }
    },
    "search_hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hypothesis_key": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1200},
          "queries": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
          "expected_information": {"type": "string", "minLength": 1, "maxLength": 800},
          "suggested_tools": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "enum": ["reverse_image_search", "text_search", "visit", "compare_with_reference", "check_consistency", "analyze_visual_anomalies", "crop_and_inspect", "ocr_with_position"]}
          },
          "priority": {"type": "integer", "minimum": 1, "maximum": 3}
        },
        "required": ["hypothesis_key", "statement", "queries", "expected_information", "suggested_tools", "priority"]
      }
    }
  },
  "required": ["account_summary", "target_facts", "search_hypotheses"]
}
