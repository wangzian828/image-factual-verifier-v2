# Next formal H20 run: clean base + one epoch over the unified canonical pool.
# The full processor-v4 audit and a one-step weighted-loss canary must pass first.
IFV_TUNER_TYPE=full
IFV_DEEPSPEED=
# Reuse the proven sharded FSDP2 route.  Checkpoints retain optimizer state so
# they are natively resumable and do not require risky full-state gathering.
IFV_FSDP=fsdp2
IFV_FSDP_VERSION=2
IFV_NUM_TRAIN_EPOCHS=1
IFV_MAX_STEPS=
IFV_TRAIN_BATCH_SIZE=1
IFV_EVAL_BATCH_SIZE=1
IFV_GRADIENT_ACCUMULATION_STEPS=1
IFV_LEARNING_RATE=1e-5
IFV_EVAL_STRATEGY=no
IFV_SAVE_STRATEGY=steps
IFV_SAVE_STEPS=400
IFV_SAVE_TOTAL_LIMIT=3
IFV_SAVE_ONLY_MODEL=false
IFV_LOGGING_STEPS=1
IFV_FREEZE_LLM=false
IFV_FREEZE_VIT=false
IFV_FREEZE_ALIGNER=false
# Disable the model-level checkpoint path; the FSDP config above provides the
# single activation-checkpoint layer without the 4.8x double-recompute cost.
IFV_GRADIENT_CHECKPOINTING=false
IFV_VIT_GRADIENT_CHECKPOINTING=false
IFV_ATTN_IMPL=flash_attn
IFV_LOAD_FROM_CACHE_FILE=true
IFV_LOSS_SCALE=ifv_agent+ignore_empty_think
IFV_EXTERNAL_PLUGINS=$REPO_ROOT/training/plugins/ifv_sft_agent_plugin.py
IFV_IMAGE_MAX_TOKEN_NUM=1024
IFV_MAX_PIXELS=262144
IFV_MAX_LENGTH=131072
IFV_TRUNCATION_STRATEGY=raise
IFV_GROUP_BY_LENGTH=true
IFV_PADDING_FREE=true
IFV_PACKING=true
IFV_PACKING_LENGTH=120000
IFV_LAZY_TOKENIZE=false
IFV_SEQUENCE_PARALLEL_SIZE=4
IFV_USE_LIGER_KERNEL=true
IFV_USE_LOGITS_TO_KEEP=false
IFV_BF16=true
IFV_FP16=false
CELOSS_PARALLEL_SIZE=2048
IFV_DATASET_NUM_PROC=4
IFV_DATALOADER_NUM_WORKERS=4
IFV_DATALOADER_PERSISTENT_WORKERS=true
IFV_DATALOADER_PREFETCH_FACTOR=2
IFV_ENCODE_CACHE_ENABLED=true
IFV_ENCODE_CACHE_NAMESPACE=qwen35-9b-h20-sp4-agent-v2
IFV_REQUIRE_TRAINING_ENV_PREFLIGHT=true
IFV_EXPECTED_GPU_COUNT=4
IFV_EXPECTED_GPU_NAME=NVIDIA\ H20
IFV_EXPECTED_GPU_MEMORY_MIB=97871
IFV_GPU_MEMORY_TOLERANCE_MIB=128
IFV_EXPECTED_PYTHON=3.12
IFV_EXPECTED_TORCH_CUDA=12.8
IFV_EXPECTED_TORCH_VERSION=2.10.0
IFV_EXPECTED_TRANSFORMERS_VERSION=5.12.1
IFV_EXPECTED_MS_SWIFT_VERSION=4.4.2
IFV_EXPECTED_DEEPSPEED_VERSION=0.19.2
IFV_EXPECTED_FLASH_ATTN_VERSION=2.8.3
IFV_EXPECTED_FLA_VERSION=0.5.1
IFV_EXPECTED_CAUSAL_CONV1D_VERSION=1.6.2.post1
IFV_EXPECTED_LIGER_VERSION=0.8.0
IFV_CHECKPOINT_ESTIMATED_BYTES=60000000000
IFV_CHECKPOINT_RESERVE_MULTIPLIER=1.25
IFV_GPU_MEMORY_TARGET_MIN_MIB=85000
IFV_GPU_MEMORY_TARGET_MAX_MIB=97871
IFV_GPU_MEMORY_MAX_IMBALANCE_MIB=2048
IFV_GPU_UTILIZATION_TARGET_MIN_PERCENT=85
IFV_RESOURCE_SAMPLE_INTERVAL=2
IFV_SFT_WATCHDOG_INTERVAL_SECONDS=30
IFV_SFT_WATCHDOG_STALE_SECONDS=1800
IFV_TRAINING_STEADY_WINDOW=5
