_IFV_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_IFV_PROFILE_DIR/qwen3.5-full-4gpu-h20-fsdp2-sp4-flash-128k-agent-v2.env"
unset _IFV_PROFILE_DIR

# Exercise the production model-only FULL_STATE_DICT checkpoint path after one
# optimizer step.  This catches save-time OOM and FSDP compatibility failures.
IFV_NUM_TRAIN_EPOCHS=
IFV_MAX_STEPS=1
IFV_EVAL_STRATEGY=no
IFV_SAVE_STRATEGY=steps
IFV_SAVE_STEPS=1
IFV_SAVE_TOTAL_LIMIT=1
IFV_SAVE_ONLY_MODEL=true
IFV_ENCODE_CACHE_ENABLED=false
