# Candidate PSD process environment only; DO NOT source into the live eval.
# This profile is not an attestation that the GPU boundary tests passed.
export PSD_GATEWAY_DEADLINE_SECONDS=1200
export AGENT_LLM_REQUEST_TIMEOUT_SECONDS=1230
export AGENT_STAGE_REQUEST_TIMEOUT_SECONDS=1260
export AGENT_LLM_REQUEST_MAX_RETRIES=0
# Public runtime adapters hide image_input; the frozen perception cache key
# does not bind that implicit image. Disable BOTH switches in PSD workers.
export TOOL_CACHE_ENABLED=0
export PERCEPTION_CACHE_ENABLED=0
# Also requires vLLM --logits-processors
# scripts.server.psd_qwen_thinking:PSDThinkingBudget and the isolated gateway.
