# H20 throughput recipe: four data-parallel samples with sparse output logits.
# The 128K ceiling is retained; memory_probe overrides to one optimizer step.
IFV_PSD_PROFILE_MODE=${IFV_PSD_PROFILE_MODE:-production}
CUDA_VISIBLE_DEVICES=0,1,2,3
IFV_TUNER_TYPE=lora
IFV_FSDP=fsdp2
IFV_FSDP_VERSION=2
IFV_DEEPSPEED=
IFV_TRAIN_BATCH_SIZE=1
IFV_GRADIENT_ACCUMULATION_STEPS=8
IFV_NUM_TRAIN_EPOCHS=5
IFV_MAX_STEPS=
IFV_LEARNING_RATE=4e-5
IFV_MAX_GRAD_NORM=1.0
IFV_SEED=0
IFV_SAVE_STRATEGY=steps
IFV_SAVE_STEPS=10
IFV_SAVE_TOTAL_LIMIT=1
IFV_LOGGING_STEPS=1
IFV_MAX_LENGTH=131072
IFV_TORCH_DTYPE=bfloat16
IFV_BF16=true
IFV_FP16=false
IFV_GRADIENT_CHECKPOINTING=true
IFV_ATTN_IMPL=flash_attn
IFV_GROUP_BY_LENGTH=true
IFV_PADDING_FREE=true
IFV_SEQUENCE_PARALLEL_SIZE=1
IFV_USE_LOGITS_TO_KEEP=true
IFV_DATASET_NUM_PROC=1
IFV_DATALOADER_NUM_WORKERS=0
IFV_PSD_TOPK=20
IFV_PSD_LOSS_CHUNK_TOKENS=128
CELOSS_PARALLEL_SIZE=128
IFV_LORA_RANK=32
IFV_LORA_ALPHA=32
IFV_LORA_DROPOUT=0.0
IFV_LORA_TARGET_MODULES=all-linear
IFV_REQUIRE_TRAINING_ENV_PREFLIGHT=true
IFV_EXPECTED_GPU_NAME=NVIDIA\ H20
IFV_EXPECTED_GPU_MEMORY_MIB=97871
IFV_EXPECTED_PYTHON=3.12
IFV_EXPECTED_TORCH_CUDA=12.8
IFV_EXPECTED_TORCH_VERSION=2.10.0
IFV_EXPECTED_TRANSFORMERS_VERSION=5.12.1
IFV_EXPECTED_MS_SWIFT_VERSION=4.4.2
IFV_EXPECTED_DEEPSPEED_VERSION=0.19.2
IFV_EXPECTED_FLASH_ATTN_VERSION=2.8.3
IFV_EXPECTED_FLA_VERSION=0.5.1
IFV_EXPECTED_CAUSAL_CONV1D_VERSION=1.6.2.post1
IFV_EXPECTED_LIGER_VERSION=0.8.0
IFV_PSD_CHECKPOINT_ESTIMATED_BYTES=8000000000
IFV_CHECKPOINT_RESERVE_MULTIPLIER=1.25
IFV_RESOURCE_SAMPLE_INTERVAL=2
IFV_SFT_WATCHDOG_INTERVAL_SECONDS=30
IFV_SFT_WATCHDOG_STALE_SECONDS=1800
IFV_TRAINING_STEADY_WINDOW=5
if [[ "$IFV_PSD_PROFILE_MODE" == "memory_probe" ]]; then
  IFV_GRADIENT_ACCUMULATION_STEPS=1
  IFV_NUM_TRAIN_EPOCHS=
  IFV_MAX_STEPS=1
  IFV_SAVE_STRATEGY=no
  IFV_TRAINING_STEADY_WINDOW=1
fi
