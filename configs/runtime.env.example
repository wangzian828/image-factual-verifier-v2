# Copy to ~/.config/image-factual-verifier/runtime.env and set mode 600.
# Never commit the populated file.

IFV_DATA_ROOT=/absolute/path/to/ifv-data
IFV_OMP_NUM_THREADS=1

# Optional network proxy used by this server.
# IFV_SERVER_PROXY=http://proxy-host:proxy-port
NO_PROXY=127.0.0.1,localhost,::1

# ModelScope is only for downloading the dataset archive.
# MODELSCOPE_API_TOKEN=

# The Qwen teacher handoff does not require Gemini or DashScope.
# These keys are only for other provider profiles.
# GEMINI_API_KEY=
# DASHSCOPE_API_KEY=

# Required Agent search and page-fetch APIs for the Qwen teacher handoff.
# SERPER_API_KEY=
# BROWSE_FETCH_PROVIDER=jina
# JINA_API_KEY=

# Required production OCR. Local EasyOCR and OCR fallback are prohibited.
# OCR_BACKEND=baidu
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=
# Alternatively, provide one controlled BAIDU_OCR_ACCESS_TOKEN.
# BAIDU_OCR_ACCESS_TOKEN=

# Required image upload for Serper Lens/reverse-image search.
# Set one explicitly selected provider. The temp provider is allowed when usable.
# IMAGE_UPLOAD_PROVIDER=oss
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=
# OSS_BUCKET_NAME=
# OSS_KEY_PREFIX=image-search
# VISUAL_SEARCH_PROVIDER=serper_lens

# Optional local Qwen endpoint/model.
# QWEN_LOCAL_BASE_URL=http://127.0.0.1:8899/v1
# QWEN_LOCAL_API_KEY=none
# QWEN_LOCAL_MODEL=served-model-name

# Optional independently deployed large Qwen teacher endpoint/model.
# QWEN_TEACHER_BASE_URL=http://teacher-host:port/v1
# QWEN_TEACHER_API_KEY=none
# QWEN_TEACHER_MODEL=served-teacher-model
# QWEN_TEACHER_VISION_MODEL=served-teacher-model
# IFV_TEACHER_ROLLOUT_PROFILE=teacher-qwen-server
# IFV_TEACHER_ROLLOUT_MODEL=served-teacher-model
# IFV_TEACHER_DATASET_ROOT=/absolute/path/to/factcheck_train-8490-20260907

# The portable launcher automatically reuses the same large-Qwen teacher API
# for webpage Evidence extraction. No Gemini key or second extractor API is needed.
# BROWSE_EXTRACT_PROVIDER=qwen_local
# BROWSE_EXTRACT_MODEL=served-teacher-model
# BROWSE_EXTRACT_BASE_URL=http://teacher-host:port/v1
# BROWSE_EXTRACT_WIRE_API=chat_completions

# Optional independent Qwen SFT judge configuration.
# IFV_SFT_ELIGIBILITY_PROVIDER=qwen_local
# IFV_SFT_ELIGIBILITY_MODEL=served-judge-model
# IFV_SFT_ELIGIBILITY_BASE_URL=http://judge-host:port/v1
# IFV_SFT_ELIGIBILITY_WIRE_API=chat_completions
# IFV_SFT_ELIGIBILITY_ENABLE_THINKING=true
# IFV_SFT_ELIGIBILITY_API_KEY=
# IFV_SFT_ELIGIBILITY_API_KEY_ENV=IFV_SFT_ELIGIBILITY_API_KEY

# Optional GPUStack endpoint.
# GPUSTACK_BASE_URL=http://gpustack-host:port/v1
# GPUSTACK_API_KEY=
# GPUSTACK_PROXY=

# Training/processor path on this host.
# IFV_MODEL_ID=/absolute/path/to/qwen-checkpoint
# IFV_TRAINING_PYTHON=/absolute/path/to/sft-environment/bin/python
# IFV_TRAINING_MODEL_PROFILE=/absolute/path/to/training/model-profile.env
# IFV_TRAINING_SFT_PROFILE=/absolute/path/to/training/sft-profile.env
# IFV_TRAINING_SCRIPT=/absolute/path/to/training/run_sft.sh
# IFV_TRAINING_EXPERIMENT_ID=ifv-sft-smoke
# IFV_TRAINING_RESUME_CHECKPOINT=/absolute/path/to/checkpoint

# Optional checkout invariants for unattended runs.
# IFV_EXPECTED_REPO_ROOT=/absolute/path/to/checkout
# IFV_EXPECTED_BRANCH=branch-name
# IFV_REQUIRE_CLEAN_CHECKOUT=1
