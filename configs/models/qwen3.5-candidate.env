# Set IFV_MODEL_ID to an actually downloaded dense Qwen3.5 checkpoint before use.
# This profile is rejected by launchers while the placeholder remains.
IFV_MODEL_ID=REQUIRED_QWEN3_5_MODEL_PATH
IFV_MODEL_FAMILY=qwen3_5
IFV_MODEL_ROLE=candidate_gate
IFV_TORCH_DTYPE=bfloat16
IFV_IMAGE_MAX_TOKEN_NUM=1024
IFV_MAX_LENGTH=16384
IFV_ENABLE_THINKING=false
IFV_ADD_NON_THINKING_PREFIX=true
